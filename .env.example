# ==============================================================================
# PARENT EMAIL REVIEW AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. AI Engine Configuration (Optional - Smart Offline Engine runs automatically when empty)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# 2. Database Connection (PostgreSQL - Optional for local, required for server DB persistence)
DATABASE_URL="postgresql://postgres:password@localhost:5432/parent_email_agent?schema=public"

# 3. Google Drive Integration (Optional for Live Cloud Drive Folder Sync)
GOOGLE_DRIVE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_DRIVE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_DRIVE_FOLDER_ID="10g-Oakwood-ParentComms-2026"
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. Next.js App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CHECKLIST_VERSION="v1.0.0-demo"
